# Application DB connection (used by Spring Boot)
DB_URL=jdbc:postgresql://localhost:5432/tournament_db
DB_USERNAME=tournament_app
DB_PASSWORD=change_me_app

# PostgreSQL bootstrap administrator (local development only)
POSTGRES_DB=tournament_db
POSTGRES_USER=tournament_admin
POSTGRES_PASSWORD=change_me_admin

# Restricted application role; uses DB_PASSWORD above
APP_DB_USER=tournament_app
SERVER_PORT=8080
